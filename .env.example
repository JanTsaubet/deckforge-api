# Copia este fichero a .env y ajusta los valores.

# Puerto de la API.
PORT=4000

# Postgres. `docker compose up -d` levanta uno con estas mismas credenciales.
DATABASE_URL=postgres://deckforge:deckforge@localhost:5432/deckforge

# Secreto de Better Auth: mínimo 32 caracteres aleatorios. Puedes generar uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=sustituye-esto-por-un-secreto-largo-y-aleatorio

# URL pública desde la que el navegador usa la autenticación. El frontend reenvía
# /api/auth/* a esta API, así que es el origen de la web, no el de la API.
BETTER_AUTH_URL=http://localhost:3000

# Origen del frontend: Better Auth solo acepta peticiones de orígenes de confianza.
WEB_ORIGIN=http://localhost:3000
